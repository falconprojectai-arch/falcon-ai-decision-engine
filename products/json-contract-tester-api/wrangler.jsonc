{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "json-contract-tester-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "previews": {},
  "durable_objects": { "bindings": [{ "name": "NONCE_STORE", "class_name": "NonceStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NonceStore"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],
  "vars": {}
}